				<0x0 0x80100000 0x0 0x00100000>, /* dbi2 */
				<0x0 0x80200000 0x0 0x00001000>, /* elbi */
				<0x0 0x80300000 0x0 0x00001000>, /* atu */
				<0x0 0x80380000 0x0 0x00001000>, /* dma */
				<0x11 0x00000000 0x0 0x10000000>, /* addr_space */
				<0x0 0x82900000 0x0 0x00001000>; /* phy ahb */
			reg-names = "dbi", "dbi2", "elbi", "atu", "dma", "addr_space", "link";

			interrupt-parent = <&saplic>;
