			clock-names = "clk_rgx";
			resets = <&syscon_apmu RESET_APMU_GPU>;
			operating-points-v2 = <&imggpu_opp_table>;
			#cooling-cells = <2>;
			thermal-zone = "thermal_gpu";
			status = "okay";

			imggpu_opp_table: opp-table {
				compatible = "operating-points-v2";

				opp-409000000 {
					opp-hz = /bits/ 64 <409000000>;
					opp-microvolt = <800000>;
					clock-latency-ns = <100000>;
				};

				opp-491000000 {
					opp-hz = /bits/ 64 <491000000>;
					opp-microvolt = <800000>;
					clock-latency-ns = <100000>;
				};

				opp-614000000 {
					opp-hz = /bits/ 64 <614000000>;
					opp-microvolt = <900000>;
					clock-latency-ns = <100000>;
				};

				opp-819000000 {
					opp-hz = /bits/ 64 <819000000>;
					opp-microvolt = <900000>;
					clock-latency-ns = <100000>;
				};

				opp-1000000000 {
					opp-hz = /bits/ 64 <1000000000>;
					opp-microvolt = <950000>;
					clock-latency-ns = <100000>;
				};

				opp-1228000000 {
					opp-hz = /bits/ 64 <1228000000>;
					opp-microvolt = <950000>;
					clock-latency-ns = <100000>;
				};
			};
		};
*/
		imggpu: gpu@cac00000 {
			compatible = "spacemit,k3-gpu", "img,img-bxm-4-64",
				     "img,img-rogue";
			interrupt-parent = <&saplic>;
			interrupts = <75 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xcac00000 0x0 0x80000>;
			reg-names = "rgxregs";
			power-domains = <&power K3_PMU_GPU_PWR_DOMAIN>;
			clocks = <&syscon_apmu CLK_APMU_GPU>;
			clock-names = "core";
			resets = <&syscon_apmu RESET_APMU_GPU>;
			#cooling-cells = <2>;
			status = "okay";
		};

                ec_master: ethercat_master {
                        compatible = "spacemit,igh-ec-master";
                        master-count = <1>;
                        status = "disabled";

                        master0 {
                                main-device = <&eth0>;
                        };
		};

		gmac_default_rxq_setup: rx-queues-config {
			snps,rx-queues-to-use = <2>;
			snps,rx-sched-sp;

			queue0 {
				snps,dcb-algorithm;
				snps,priority = <0x0f>;
				snps,map-to-dma-channel = <0>;
			};

			queue1 {
				snps,dcb-algorithm;
				snps,priority = <0xf0>;
				snps,map-to-dma-channel = <1>;
			};
		};

		gmac_default_txq_setup: tx-queues-config {
			snps,tx-queues-to-use = <2>;

			queue0 {
				snps,dcb-algorithm;
			};

			queue1 {
				snps,dcb-algorithm;
			};
		};

		eth0: ethernet@cac80000 {
			compatible = "spacemit,k3-gmac", "snps,dwmac-5.10a";
			reg = <0x0 0xcac80000 0x0 0x2000>;
			spacemit,apmu = <&syscon_apmu>;
			spacemit,ctrl-offset = <0x3e4>;
			spacemit,dline-offset = <0x3e8>;
			clocks = <&syscon_apmu CLK_APMU_EMAC0_BUS>,
				 <&syscon_apmu CLK_APMU_EMAC0_1588>;
			clock-names = "stmmaceth", "ptp_ref";
			resets = <&syscon_apmu RESET_APMU_EMAC0>;
			reset-names = "stmmaceth";
			interrupt-parent = <&saplic>;
			interrupts = <131 IRQ_TYPE_LEVEL_HIGH>, <276 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_wake_irq";
			mac-address = [00 00 00 00 00 00];
			tx-fifo-depth = <8192>;
			rx-fifo-depth = <8192>;
			snps,tso;
			snps,force_sf_dma_mode;
			snps,axi-config = <&gmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_default_rxq_setup>;
			snps,mtl-tx-config = <&gmac_default_txq_setup>;
			status = "disabled";
		};

		eth1: ethernet@cac82000 {
			compatible = "spacemit,k3-gmac", "snps,dwmac-5.10a";
			reg = <0x0 0xcac82000 0x0 0x2000>;
			spacemit,apmu = <&syscon_apmu>;
