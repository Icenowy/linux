		i2s0: i2s0@d4026000 {
			compatible = "spacemit,k1-i2s";
			#sound-dai-cells = <0>;
			reg = <0x0 0xD4026000 0x0 0x30>;
			clocks = <&syscon_mpmu CLK_MPMU_I2S0_SYSCLK_DIV>,
				 <&syscon_mpmu CLK_MPMU_I2S0_SYSCLK>,
				 <&syscon_apbc CLK_APBC_I2S0_BCLK>,
				 <&syscon_apbc CLK_APBC_I2S0_BUS>,
				 <&syscon_apbc CLK_APBC_I2S0>,
				 <&syscon_mpmu CLK_MPMU_I2S_SYSCLK>,
				 <&syscon_mpmu CLK_MPMU_I2S_BCLK>;
			clock-names = "sysclk_div", "sysclk",
				      "bclk", "sspa_bus", "sspa", "c_sysclk", "c_bclk";
			resets = <&syscon_apbc RESET_APBC_I2S0>;
			assigned-clocks = <&syscon_mpmu CLK_MPMU_I2S_153P6_BASE>,
					  <&syscon_mpmu CLK_MPMU_I2S_SYSCLK_SRC>,
					  <&syscon_mpmu CLK_MPMU_I2S_SYSCLK>,
					  <&syscon_mpmu CLK_MPMU_I2S_BCLK>,
					  <&syscon_mpmu CLK_MPMU_I2S0_SYSCLK_SEL>;
			assigned-clock-rates = <307200000>, <307200000>,
					       <12288000>, <1536000>, <614400000>;
			/* must set to same value when enable multi i2s: 8000/16000/48000Hz */
			/* spacemit,fixed-sample-rate = <48000>; */
			dmas = <&pdma 22>, <&pdma 21>;
			dma-names = "rx", "tx";
			status = "disabled";
		};

